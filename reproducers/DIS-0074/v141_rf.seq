# Pulseq sequence file
# Hand-written reproducer of pulseq-discrepancies.

[VERSION]
major 1
minor 4
revision 1

[DEFINITIONS]
AdcRasterTime 1e-07
BlockDurationRaster 1e-05
GradientRasterTime 1e-05
RadiofrequencyRasterTime 1e-06

# Format of blocks:
# NUM DUR RF GX GY GZ ADC EXT
[BLOCKS]
1 30 1 0 0 0 0 0

# Format of RF events:
# id amplitude mag_id phase_id time_shape_id delay freq phase
# ..        Hz   ....     ....          ....    us   Hz   rad
[RF]
1 250 1 2 0 100 0 0

# Sequence Shapes
[SHAPES]

shape_id 1
num_samples 100
1
1
98

shape_id 2
num_samples 100
0
0
98

