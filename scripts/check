#!/usr/bin/env bash
# All the checks that CI runs, in one command. Run it in the devShell:
#
#   nix develop --command scripts/check
set -euo pipefail
cd "$(dirname "$0")/.."

# The front matter of each record in discrepancies/ (docs/record-format.md).
uv run --locked python scripts/validate_records.py
# The tests of the validator.
uv run --locked pytest
# docs/priorities.md is the one that the records give.
uv run --locked python scripts/priorities.py --check
